# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for property media (create in Supabase Storage UI)
NEXT_PUBLIC_STORAGE_BUCKET=property-media

# ─────────────────────────────────────────────────────────────
# Storage provider ('supabase' now, 'r2' later)
# ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase

# ─────────────────────────────────────────────────────────────
# Gemini (Phase 4 — leave blank until you enable AI descriptions)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Reverse geocoding — pick ONE. If both empty, falls back to
# free OpenStreetMap (weaker India address data).
# ─────────────────────────────────────────────────────────────

# MapmyIndia (Mappls) — best India address quality, free tier no card
# https://about.mappls.com/api/  (Individual → OAuth REST API)
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# Ola Maps — decent India data, needs card for signup
# https://maps.olakrutrim.com/
OLA_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
